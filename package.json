{
  "name": "poizon-buyer-catalog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run verify:assets && npm run verify:boundaries && tsc -b && vite build && npm run verify:dist",
    "build:production": "npm run verify:release && npm run verify:boundaries && tsc -b && vite build && npm run verify:dist",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:maintainer": "node scripts/run_maintainer_tests.mjs",
    "test:watch": "vitest",
    "lint": "oxlint",
    "media:prompts": "node scripts/export_gpt_image_prompts.mjs",
    "verify:assets": "node scripts/verify_catalog_assets.mjs",
    "verify:boundaries": "node scripts/verify_site_boundaries.mjs",
    "verify:dist": "node scripts/verify_dist_portability.mjs",
    "verify:media-pipeline": "node scripts/verify_product_media_pipeline.mjs",
    "verify:release-rights": "node scripts/verify_release_rights.mjs",
    "verify:release": "npm run verify:assets && npm run verify:release-rights",
    "check": "npm run lint && npm test && npm run verify:media-pipeline && npm run test:maintainer && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "motion": "12.43.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "oxlint": "1.71.0",
    "typescript": "6.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
