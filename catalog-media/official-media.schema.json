{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kicksbase.ru/schemas/official-product-media-v1.json",
  "title": "KICKSBASE official product media intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "product_type",
        "identifiers",
        "source",
        "rights",
        "media",
        "qa"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "product_type": {
          "enum": ["footwear", "apparel", "accessory"]
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spu": { "type": ["string", "null"] },
            "sku": { "type": ["string", "null"] }
          },
          "anyOf": [
            {
              "required": ["spu"],
              "properties": { "spu": { "type": "string", "minLength": 1 } }
            },
            {
              "required": ["sku"],
              "properties": { "sku": { "type": "string", "minLength": 1 } }
            }
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "asset_url",
            "product_url",
            "observed_at",
            "local_file",
            "sha256"
          ],
          "properties": {
            "provider": { "type": "string", "minLength": 3 },
            "asset_url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "product_url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "observed_at": { "$ref": "#/$defs/timestamp" },
            "local_file": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence_reference",
            "verified_by",
            "verified_at",
            "permitted_uses"
          ],
          "properties": {
            "status": { "enum": ["licensed", "owned", "supplier-api"] },
            "evidence_reference": { "type": "string", "minLength": 8 },
            "verified_by": { "type": "string", "minLength": 2 },
            "verified_at": { "$ref": "#/$defs/timestamp" },
            "permitted_uses": {
              "type": "array",
              "contains": { "const": "storefront" },
              "items": { "type": "string" }
            }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "angle", "orientation", "mime_type"],
          "properties": {
            "role": { "enum": ["primary", "gallery"] },
            "angle": {
              "enum": [
                "side",
                "front",
                "rear",
                "three-quarter",
                "top",
                "sole",
                "detail"
              ]
            },
            "orientation": {
              "enum": ["toe-right", "toe-left", "front-facing", "rear-facing", "not-applicable"]
            },
            "mime_type": { "enum": ["image/jpeg", "image/png", "image/webp"] }
          }
        },
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "product_match_verified",
            "source_not_cropped",
            "logos_and_text_readable",
            "orientation_verified",
            "subject_scale_verified",
            "reviewer",
            "reviewed_at",
            "notes"
          ],
          "properties": {
            "status": { "const": "approved" },
            "product_match_verified": { "const": true },
            "source_not_cropped": { "const": true },
            "logos_and_text_readable": { "const": true },
            "orientation_verified": { "const": true },
            "subject_scale_verified": { "const": true },
            "reviewer": { "type": "string", "minLength": 2 },
            "reviewed_at": { "$ref": "#/$defs/timestamp" },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
